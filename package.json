{
    "name": "focuslist",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port=3000 --host=0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit",
        "test": "tsx --test src/utils/todoLogic.test.ts src/utils/undoRedoManager.test.ts src/utils/timerState.test.ts src/utils/calendarLogic.test.ts src/utils/persistence.test.ts src/utils/syncLogic.test.ts",
        "test:rules": "firebase emulators:exec --only firestore --project demo-focuslist \"tsx --test tests/firestore.rules.test.ts\"",
        "emulators": "firebase emulators:start --only auth,firestore --project demo-focuslist",
        "dev:emulators": "vite --mode emulators --port=3000 --host=0.0.0.0",
        "deploy": "npm run build && firebase deploy --only hosting,firestore"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "firebase": "^12.19.0",
        "lucide-react": "^0.546.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "vite": "^8.3.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@types/node": "^22.14.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.4.21",
        "esbuild": "^0.28.0",
        "firebase-tools": "^15.37.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2"
    }
}
